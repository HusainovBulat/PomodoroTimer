<Window x:Class="PomodoroTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Таймер" Icon="app.ico"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        BorderBrush="{DynamicResource Line}" BorderThickness="1"
        FontFamily="Segoe UI" FontSize="11"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
	<!-- Все размеры — в DIP (1/96 дюйма): WPF сам пересчитывает их под масштаб каждого монитора. -->
	<Window.Resources>
		<SolidColorBrush x:Key="Bg" Color="#1B2129" />
		<SolidColorBrush x:Key="Bg2" Color="#262E38" />
		<SolidColorBrush x:Key="Line" Color="#3A4552" />
		<SolidColorBrush x:Key="Fg" Color="#E8EDF3" />
		<SolidColorBrush x:Key="Muted" Color="#93A0B0" />
		<SolidColorBrush x:Key="Accent" Color="#F07A42" />
		<SolidColorBrush x:Key="Done" Color="#53B884" />
		<SolidColorBrush x:Key="Bad" Color="#6B2A22" />
		<SolidColorBrush x:Key="Over" Color="#E5534B" />
		<FontFamily x:Key="Mono">Consolas</FontFamily>

		<Style TargetType="Button">
			<Setter Property="Background" Value="{StaticResource Bg2}" />
			<Setter Property="Foreground" Value="{StaticResource Fg}" />
			<Setter Property="BorderBrush" Value="{StaticResource Line}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Height" Value="26" />
			<Setter Property="Margin" Value="0,0,4,0" />
			<Setter Property="FontFamily" Value="Segoe UI Symbol" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Focusable" Value="False" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Opacity" Value="0.85" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="bd" Property="Opacity" Value="0.65" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Window.ContextMenu>
		<ContextMenu>
			<MenuItem x:Name="miLog" Header="Список отметок" IsCheckable="True" IsChecked="True" />
			<MenuItem x:Name="miExit" Header="Выход" />
		</ContextMenu>
	</Window.ContextMenu>

	<StackPanel Width="214" Margin="8,6,8,8">
		<!-- строка 1: отрезок | общий остаток | закрыть -->
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="lblSeg" Text="9:00" FontFamily="{StaticResource Mono}" FontSize="27" FontWeight="Bold"
                       VerticalAlignment="Center" />
			<TextBlock x:Name="lblTotal" Grid.Column="1" Text="Σ 9:00" FontFamily="{StaticResource Mono}" FontSize="16"
                       VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Всего осталось" />
			<TextBlock x:Name="lblClose" Grid.Column="2" Text="×" FontSize="15" Foreground="{StaticResource Muted}"
                       Cursor="Hand" VerticalAlignment="Top" Margin="0,-2,0,0" Padding="2,0" Background="Transparent" />
		</Grid>

		<!-- строка 2: номер отрезка, прошло, всего -->
		<TextBlock x:Name="lblInfo" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />

		<!-- строка 3: кнопки и длина отрезка -->
		<StackPanel Orientation="Horizontal" Margin="0,0,0,4">
			<Button x:Name="btnAdd" Content="+9" Width="56" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}"
                    Foreground="{StaticResource Bg}" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                    ToolTip="Новый отрезок + отметка (Enter)" />
			<Button x:Name="btnPause" Content="▶" Width="34" ToolTip="Старт / пауза (Пробел)" />
			<Button x:Name="btnReset" Content="↺" Width="34" ToolTip="Сбросить всё" />
			<TextBox x:Name="txtInterval" Text="9:00" Width="52" Margin="6,0,0,0" VerticalContentAlignment="Center"
                     FontFamily="{StaticResource Mono}" FontSize="13" TextAlignment="Center"
                     Background="{StaticResource Bg2}" Foreground="{StaticResource Fg}" CaretBrush="{StaticResource Fg}"
                     BorderBrush="{StaticResource Line}" ToolTip="Длина отрезка: минуты или мм:сс" />
		</StackPanel>

		<!-- строка 4: отметки -->
		<TextBlock x:Name="lblLogHead" Foreground="{StaticResource Muted}" Text="№   от пред.   от старта" />
		<ScrollViewer x:Name="logScroll" Height="66" Background="{StaticResource Bg2}"
                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
			<ItemsControl x:Name="lstLog" Padding="2,1" FontFamily="{StaticResource Mono}" FontSize="12">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding}" LineStackingStrategy="BlockLineHeight" LineHeight="16" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</StackPanel>
</Window>